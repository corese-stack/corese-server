            "body": {
              "mode": "raw",
              "raw": "INSERT DATA {\n  <http://example.org/Patched> <http://example.org/by> <http://example.org/PATCH> .\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rdf-graph-store?graph=http://example.org/graph1",

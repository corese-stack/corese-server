            ],
            "body": {
              "mode": "raw",
              "raw": "DELETE DATA {\n  <http://example.org/Alice> <http://example.org/knows> <http://example.org/Bob> .\n}"
            },
            "url": "{{baseUrl}}/sparql"
          }
        },
        {
          "name": "POST URL-encoded update",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "update",
                  "value": "INSERT DATA { <http://example.org/X> <http://example.org/y> <http://example.org/Z> . }"
                }
              ]
            },
            "url": "{{baseUrl}}/sparql"
          }
        },
        {
          "name": "INSERT WHERE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/sparql-update"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "INSERT { ?s <http://example.org/copy> ?o }\nWHERE { ?s <http://example.org/knows> ?o }"

    {
      "name": "SPARQL Update",
      "item": [
        {
          "name": "INSERT DATA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/sparql-update"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "INSERT DATA {\n  <http://example.org/Alice> <http://example.org/knows> <http://example.org/Bob> .\n  <http://example.org/Bob>   <http://example.org/knows> <http://example.org/Carol> .\n}"
            },
            "url": "{{baseUrl}}/sparql"
          }
        },
        {
          "name": "SELECT after INSERT - should return 2 results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sparql?query=SELECT * WHERE { ?s ?p ?o }",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sparql"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "SELECT * WHERE { ?s ?p ?o }"
                }
              ]
            }
          }
        },

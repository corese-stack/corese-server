            "url": {
              "raw": "{{baseUrl}}/rdf-graph-store?graph=http://example.org/graph1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rdf-graph-store"
              ],
              "query": [
                {
                  "key": "graph",
                  "value": "http://example.org/graph1"

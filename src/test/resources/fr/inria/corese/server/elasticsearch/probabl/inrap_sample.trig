  foaf:made owl:inverseOf foaf:maker .
  
  <http://www.inrap.fr/archipel/inrap_ont/> rdfs:comment """Inrap Ontology v1.2 implemented in RDFS
Encoding Rules:
1. The RDF spelling rules do not allow blanks. Hence we have replaced them by underscores.
   For instance \"Project\" or \"is_responsible_for\".

2. RDF does not allow to instantiate properties beginning from a range value.
   Therefore, each inrap property is represented as two RDFS properties.
   For instance \"IP1 has project responsible (is responsible for)\" is represented as:
   \"has_project_responsible\" for the domain to range direction and \"is_responsible_for\" for the range to domain direction.
"""@en .
  
  inrap:RankedAuthor rdfs:comment "Used to keep the order of the authors within a publication"@en .
  
  inrap:WeightedConceptLink rdfs:comment "used to link to a concept with a weight parameter, for instance the occurrence of a concept within a corpus"@en;
    rdfs:label "Weighted Concept Link" .
  
  inrap:WeightedPersonLink rdfs:comment "used to link to a person with a weight parameter, for instance the number of collaborations between 2 persons"@en;
    rdfs:label "Weighted Person Link" .
}


inrap:ng {
  inrap:has_operation_responsible rdfs:subPropertyOf inrap:has_operation_contributor;
    rdfs:domain inrap:Operation;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_responsible_for_operation;
    rdfs:label "has operation responsible"@en .
  
  inrap:has_insee_uri rdfs:subPropertyOf crm:P89_falls_within;
    rdfs:domain inrap:Place;
    rdfs:range inrap:Place .
  
  inrap:has_boundaries rdfs:subPropertyOf aocat:has_space_region;
    rdfs:domain crm:E7_Activity;
    rdfs:range inrap:Multipolygon .
  
  inrap:has_boundaries_center rdfs:subPropertyOf aocat:has_space_region;
    rdfs:domain crm:E7_Activity;
    rdfs:range inrap:Point .
  
  inrap:is_linked_operation_of rdfs:subPropertyOf crm:P14i_performed;
    rdfs:domain inrap:Operation;
    rdfs:range inrap:Project;
    owl:inverseOf inrap:has_linked_operation;
    rdfs:label "is linked operation of"@en .
  
  inrap:has_linked_operation rdfs:subPropertyOf crm:P9_consists_of;
    rdfs:domain inrap:Project;
    rdfs:range inrap:Operation;
    owl:inverseOf inrap:is_linked_operation_of;
    rdfs:label "has linked operation"@en .
  
  inrap:is_employed_by rdfs:subPropertyOf crm:P107i_is_current_or_former_member_of;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Organization;
    owl:inverseOf inrap:is_employer_of;
    rdfs:label "is employed by"@en .
  
  inrap:is_employer_of rdfs:subPropertyOf crm:P107_has_current_or_former_member;
    rdfs:domain inrap:Organization;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_employed_by;
    rdfs:label "is employer of"@en .
  
  inrap:is_labmember_of rdfs:subPropertyOf crm:P107i_is_current_or_former_member_of;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Organization, inrap:Group;
    owl:inverseOf inrap:has_labmember;
    rdfs:label "is labmember of"@en .
  
  inrap:has_labmember rdfs:subPropertyOf crm:P107_has_current_or_former_member;
    rdfs:domain inrap:Group;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_labmember_of;
    rdfs:label "has labmember"@en .
  
  inrap:has_project_responsible rdfs:subPropertyOf inrap:has_project_contributor;
    rdfs:domain inrap:Project;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_responsible_for;
    rdfs:label "has project responsible"@en .
  
  inrap:is_responsible_for rdfs:subPropertyOf inrap:is_project_contributor_of;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Project;
    owl:inverseOf inrap:has_project_responsible;
    rdfs:label "is responsible for"@en .
  
  inrap:has_project_participant rdfs:subPropertyOf inrap:has_project_contributor;
    rdfs:domain inrap:Project;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:has_participated_in;
    rdfs:label "has project participant"@en .
  
  inrap:has_participated_in rdfs:subPropertyOf inrap:is_project_contributor_of;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Project;
    owl:inverseOf inrap:has_project_participant;
    rdfs:label "has participated in"@en .
  
  inrap:has_contributor rdfs:subPropertyOf aocat:has_contributor, foaf:maker;
    rdfs:domain inrap:Report, crm:E31_Document;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_contributor_of;
    rdfs:label "has contributor"@en, "has secondary contributor"@en .
  
  inrap:is_contributor_of rdfs:subPropertyOf aocat:is_contributor_of, foaf:made;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Report;
    owl:inverseOf inrap:has_contributor;
    rdfs:label "is_contributor_of"@en .
  
  inrap:has_author rdfs:subPropertyOf aocat:has_contributor, foaf:maker;
    rdfs:domain crm:E31_Document;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_author_of;
    rdfs:label "has author"@en .
  
  inrap:is_author_of rdfs:subPropertyOf aocat:is_contributor_of, foaf:made;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Report;
    owl:inverseOf inrap:has_author;
    rdfs:label "is author of"@en .
  
  inrap:has_coauthor rdfs:subPropertyOf aocat:has_contributor, foaf:maker;
    rdfs:domain crm:E31_Document;
    rdfs:range inrap:Person;
    owl:inverseOf inrap:is_coauthor_of;
    rdfs:label "has coauthor"@en .
  
  inrap:is_coauthor_of rdfs:subPropertyOf aocat:is_contributor_of, foaf:made;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Report;
    owl:inverseOf inrap:has_coauthor;
    rdfs:label "is coauthor of"@en .
  
  inrap:is_responsible_for_operation rdfs:subPropertyOf inrap:is_contributor_of_operation;
    rdfs:domain inrap:Person;
    rdfs:range inrap:Operation;
    owl:inverseOf inrap:has_operation_responsible;
    rdfs:label "is responsible for operation"@en .
  
  inrap:has_involvement_role rdfs:subPropertyOf mnx:hasRole;
    rdfs:domain inrap:Involvement;
    rdfs:range skos:Concept .
  
  inrap:is_type_of_research_supported_by rdfs:subPropertyOf crm:P2i_is_type_of;
    rdfs:domain skos:Concept, crm:E55_Type;
    rdfs:range inrap:Project;
    rdfs:label "is type of research supported by"@en .
  

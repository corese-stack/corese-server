    aocat:has_identifier "/64298/0121833";
    aocat:has_native_subject inrapconpac:default%3ATHES_SUJET_CONCEPTS%3A13194, inrapconpac:default%3ATHES_SUJET_CONCEPTS%3A21838;
    aocat:has_original_id "21833";
    aocat:has_publisher <http://www.inrap.fr/archipel/data/agent-publisher#338>;
    aocat:has_spatial_coverage inrapconpac:default%3ATHES_LIEU_CONCEPTS%3A8035;
    aocat:has_title "Mandeure (Doubs), 50 rue de la Libération";
    aocat:has_description """Le diagnostic archéologique a permis de montrer que ce secteur se trouvait en dehors de la
                        zone urbanisée du site antique de Mandeure. Si ce secteur semble être vierge de constructions,
                        il a cependant bénéficié d’un aménagement sous la forme de la mise en place d’un remblai sans
                        doute destiné à contenir les débordements de la rivière. Ce problème lié aux crues du Doubs a
                        perduré jusqu’à une époque récente. En effet, le terrain s’est trouvé de nouveau remblayé sans
                        doute au cours de la première moitié du XXe siècle, période de forte expansion du village de
                        Mandeure due à l’essor des usines Peugeot.""" .
  
  inraprep:60847 crm:P70_documents inrapope:D134968;
    inrap:has_subtitle "rapport de diagnostic";
    inrap:publishing_place "Glisy";
    aocat:has_identifier "/64298/0160847";
    aocat:has_native_subject inrapconpac:default%3ATHES_SUJET_CONCEPTS%3A28080;
